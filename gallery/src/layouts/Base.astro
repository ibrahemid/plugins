---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'plugins', description = 'Claude Code plugins.' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <title>{title}</title>
  <style is:global>
    :root {
      color-scheme: light dark;
      --bg: #f9f8f4;
      --bg-elev: #ffffff;
      --bg-sunken: #f1f0eb;
      --fg: #1a1a1a;
      --fg-muted: #5b5b5b;
      --fg-faint: #8a8a8a;
      --accent: #6d28d9;
      --accent-soft: rgba(109, 40, 217, 0.08);
      --accent-line: rgba(109, 40, 217, 0.2);
      --border: #e6e4dd;
      --border-strong: #d2cfc5;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
      --mono: ui-monospace, "JetBrains Mono", "Fira Code", "SF Mono", Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0e0e10;
        --bg-elev: #17171a;
        --bg-sunken: #0a0a0c;
        --fg: #ededf0;
        --fg-muted: #a9a9b0;
        --fg-faint: #6e6e75;
        --accent: #c4b5fd;
        --accent-soft: rgba(196, 181, 253, 0.10);
        --accent-line: rgba(196, 181, 253, 0.28);
        --border: #26262b;
        --border-strong: #3a3a40;
      }
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-line); transition: border-color 120ms; }
    a:hover { border-bottom-color: var(--accent); }
    code { font-family: var(--mono); font-size: 0.875em; background: var(--bg-sunken); padding: 1px 6px; border-radius: 4px; border: 1px solid var(--border); }
    .container { max-width: 1100px; margin: 0 auto; padding: 64px 32px; }
    .site-head { padding-bottom: 32px; border-bottom: 1px solid var(--border); margin-bottom: 48px; }
    .site-title { font-size: 0.875rem; font-family: var(--mono); color: var(--fg-muted); margin: 0 0 4px; letter-spacing: 0.04em; text-transform: uppercase; }
    .site-tag { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; max-width: 720px; }
    .site-nav { display: flex; gap: 18px; margin-top: 24px; font-size: 0.875rem; }
    .site-nav a { border-bottom: none; color: var(--fg-muted); }
    .site-nav a:hover { color: var(--fg); }
    .site-foot { margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 0.8125rem; color: var(--fg-faint); display: flex; justify-content: space-between; }
    @media (max-width: 720px) {
      .container { padding: 40px 20px; }
      .site-tag { font-size: 1.5rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="site-head">
      <p class="site-title">plugins</p>
      <h1 class="site-tag"><slot name="tagline">Claude Code plugins.</slot></h1>
      <nav class="site-nav">
        <a href={baseUrl}>Plugins</a>
        <a href="https://github.com/ibrahemid/plugins">Source</a>
        <a href="https://github.com/ibrahemid/plugins/issues">Issues</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-foot">
      <span>MIT licensed.</span>
      <span>Built with <a href="https://astro.build">Astro</a>.</span>
    </footer>
  </div>
</body>
</html>
