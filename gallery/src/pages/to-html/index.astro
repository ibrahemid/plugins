---
import Base from '../../layouts/Base.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const shots = `${baseUrl}/screenshots`;
const examples = `${baseUrl}/examples/to-html`;

const templates = [
  {
    id: 'diagram',
    n: '01',
    name: 'diagram',
    tag: 'interactive module map · hover to trace · click to focus',
    trigger: '```mermaid block with graph TD or graph LR',
    body: 'Mermaid graph syntax is parsed server-side, laid out topologically, and rendered as pure SVG. Hover a node to dim the rest and trace its callers and callees; click to lock the focus. No mermaid runtime — the diagram ships as plain SVG inside the artifact.',
    thumb: `${shots}/thumb-diagram.png`,
    live: `${examples}/diagram.html`,
    decision: 'Hover and click to explore. Open the live artifact for the full interaction.'
  },
  {
    id: 'plan',
    n: '02',
    name: 'plan',
    tag: 'phase sidebar · live status · focus checkboxes',
    trigger: '## Phase N: headings or three-plus [ ] tasks',
    body: 'Phase sidebar with progress bars, status badges per task (◯ pending · ◐ in-progress · ● done · ✕ failed), and a meta-refresh that re-renders every three seconds. As Claude reports task progress in plain English, the Stop hook diffs the reply and flips statuses live.',
    thumb: `${shots}/thumb-plan.png`,
    live: `${examples}/plan.html`,
    decision: 'Tick the tasks you want focused next. Copy as prompt emits only those — never the whole plan.'
  },
  {
    id: 'comparison',
    n: '03',
    name: 'comparison',
    tag: 'side-by-side · pros / cons · pick + reason',
    trigger: 'Two or three ## Option / Approach / Variant headings',
    body: 'Side-by-side cards. Pros and cons are detected and pulled into their own colored panels. An effort meter and a "recommended" badge appear when Claude marks them.',
    thumb: `${shots}/thumb-comparison.png`,
    live: `${examples}/comparison.html`,
    decision: 'Click a card to pick. Type a one-line reason. Copy as prompt emits the choice and the reason.'
  },
  {
    id: 'explainer',
    n: '04',
    name: 'explainer',
    tag: 'TL;DR pill · sticky TOC',
    trigger: 'TL;DR keyword or multi-section structure without heavy bulleting',
    body: 'For "explain X" replies. TL;DR pill at the top, a sticky table of contents on the side, the body sized for actual reading. No decision bar — this template is for understanding, not deciding.',
    thumb: `${shots}/thumb-explainer.png`,
    live: `${examples}/explainer.html`,
    decision: 'Read-only.'
  },
  {
    id: 'prose',
    n: '05',
    name: 'prose',
    tag: 'editorial typography · drop cap · roman-numeral sections',
    trigger: 'Anything substantive that doesn\'t match another template',
    body: 'The fallback for general prose. Iowan Old Style with old-style numerals, ochre drop cap, Roman-numeral section markers in the left margin, asterism between sections, ❦ end mark — this is the one template that does lean editorial, because reading the agent\'s notes is what prose is for.',
    thumb: `${shots}/thumb-prose.png`,
    live: `${examples}/prose.html`,
    decision: 'Read-only.'
  }
];
---
<Base title="to-html — specimen sheet" description="Six templates, one toggle. Live interactive examples of to-html.">

  <section class="hero">
    <p class="kicker">to-html · specimen sheet</p>
    <h1 class="head">Six templates.<br>One&nbsp;toggle.</h1>
    <p class="dek">
      Type <code>/to-html</code> once. Every substantive reply is classified server-side and rendered into the template that fits the
      content. Click any preview to interact with the real artifact — these are the same HTML files the plugin produces on disk.
    </p>

    <div class="install">
      <div class="install-row">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">/plugin marketplace add ibrahemid/plugins</span>
        <button type="button" class="copy" data-clip="/plugin marketplace add ibrahemid/plugins" aria-label="Copy marketplace command">copy</button>
      </div>
      <div class="install-row">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">/plugin install to-html@ibrahemid</span>
        <button type="button" class="copy" data-clip="/plugin install to-html@ibrahemid" aria-label="Copy install command">copy</button>
      </div>
    </div>
  </section>

  <div class="section-label"><span>01 / index</span></div>

  <nav class="toc" aria-label="Templates">
    <ol>
      {templates.map((t) => (
        <li>
          <a href={`#${t.id}`}>
            <span class="toc-n">{t.n}</span>
            <span class="toc-name">{t.name}</span>
            <span class="toc-tag">{t.tag}</span>
          </a>
        </li>
      ))}
      <li class="toc-skip">
        <span class="toc-n">06</span>
        <span class="toc-name">skip</span>
        <span class="toc-tag">under 240 chars, no structure — no artifact at all</span>
      </li>
    </ol>
  </nav>

  <div class="section-label"><span>02 / templates</span></div>

  <section class="specimens">
    {templates.map((t) => (
      <article id={t.id} class="spec">
        <header class="spec-head">
          <span class="spec-n">{t.n}</span>
          <div>
            <p class="spec-tag">{t.tag}</p>
            <h2 class="spec-name">{t.name}</h2>
          </div>
        </header>

        <div class="spec-grid">
          <div class="spec-meta">
            <dl>
              <dt>triggers on</dt>
              <dd><code>{t.trigger}</code></dd>
              <dt>interaction</dt>
              <dd>{t.decision}</dd>
            </dl>
            <p class="spec-actions">
              <a href={t.live} target="_blank" rel="noopener">open live artifact →</a>
            </p>
          </div>
          <div class="spec-body">
            <p>{t.body}</p>
          </div>
        </div>

        <a class="spec-shot" href={t.live} target="_blank" rel="noopener" aria-label={`Open ${t.name} live`}>
          <img src={t.thumb} alt={`${t.name} preview`} loading="lazy" width="2880" height="1800">
          <span class="spec-shot-overlay">open live →</span>
        </a>
      </article>
    ))}
  </section>

  <div class="section-label"><span>03 / override</span></div>

  <section class="appendix">
    <p>
      If the classifier picks wrong, force a template by prepending a fenced block to a reply:
    </p>
<pre>{`\`\`\`to-html
{"template":"comparison","title":"Three approaches"}
\`\`\``}</pre>
    <p>
      Unknown templates fall back to the classifier. Skip is rejected — refusal disguised as override.
    </p>
  </section>

  <script>
    document.querySelectorAll('.copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-clip');
        if (!text) return;
        const restore = btn.textContent;
        const done = () => {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = restore; }, 1200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, () => fallback(text, done));
        } else fallback(text, done);
      });
    });
    function fallback(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.position = 'absolute'; ta.style.left = '-9999px';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
      done();
    }
  </script>
</Base>

<style>
  .hero { margin: 0 0 64px; }
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 12px;
  }
  .head {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .dek {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 28px;
  }
  .dek code { font-size: 0.92em; }

  .install { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .install-row {
    display: inline-flex;
    align-items: center;
    background: var(--terminal-bg);
    color: var(--terminal-fg);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 4px 4px 4px 14px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1;
  }
  .install-row .prompt { color: var(--terminal-prompt); font-weight: 600; margin-right: 10px; }
  .install-row .cmd { padding: 8px 14px 8px 0; }
  .install-row .copy {
    background: var(--terminal-fg);
    color: var(--terminal-bg);
    border: 0;
    padding: 8px 14px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-weight: 600;
  }
  .install-row .copy:hover { opacity: 0.85; }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .toc li { border-bottom: 1px solid var(--rule); }
  .toc a, .toc .toc-skip {
    display: grid;
    grid-template-columns: 56px 200px 1fr;
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    color: var(--ink);
    border-bottom: none;
    transition: background 120ms ease;
  }
  .toc a:hover { background: var(--paper-tint); color: var(--ink); }
  .toc a:hover .toc-name { color: var(--accent); }
  .toc-n {
    font-family: var(--mono);
    color: var(--ink-faint);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .toc-name {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
  }
  .toc-tag {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .toc-skip { color: var(--ink-faint); }
  .toc-skip .toc-name { color: var(--ink-faint); }

  .specimens { display: flex; flex-direction: column; gap: 56px; }

  .spec { margin: 0; }
  .spec-head {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: end;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .spec-n {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .spec-tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 4px;
  }
  .spec-name {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1;
    margin: 0;
    color: var(--ink);
  }
  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 56px;
    align-items: start;
    padding-left: 92px;
  }
  .spec-meta dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .spec-meta dt {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.66rem;
    margin: 0;
  }
  .spec-meta dd { margin: 0; color: var(--ink-muted); }
  .spec-meta dd code { font-size: 0.86em; }

  .spec-actions {
    margin: 20px 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .spec-actions a { color: var(--accent); border-bottom-color: var(--accent-line); }

  .spec-body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 56ch;
  }

  .spec-shot {
    display: block;
    margin: 32px 0 0 92px;
    border: 1px solid var(--rule);
    background: var(--paper-tint);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    border-radius: 4px;
    transition: border-color 200ms ease;
  }
  .spec-shot:hover { border-color: var(--accent); }
  .spec-shot img { display: block; width: 100%; height: auto; }
  .spec-shot-overlay {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    border-radius: 3px;
    transform: translateY(4px);
    opacity: 0;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .spec-shot:hover .spec-shot-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .appendix { max-width: 720px; }
  .appendix p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 14px;
    max-width: 56ch;
  }
  .appendix pre { display: block; margin: 16px 0; max-width: 100%; }

  @media (max-width: 960px) {
    .spec-grid { grid-template-columns: 1fr; gap: 20px; padding-left: 0; }
    .spec-shot { margin-left: 0; }
    .spec-head { grid-template-columns: 48px 1fr; gap: 14px; }
    .spec-n { font-size: 1.875rem; }
    .toc a, .toc .toc-skip { grid-template-columns: 40px 1fr; grid-template-rows: auto auto; }
    .toc-tag { grid-column: 2; }
  }
</style>
