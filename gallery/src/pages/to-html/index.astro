---
import Base from '../../layouts/Base.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const shots = `${baseUrl}/screenshots`;
const examples = `${baseUrl}/examples/to-html`;

const parts = [
  {
    id: 'tldr',
    n: '01',
    name: 'TL;DR band',
    tag: 'the summary the reply led with, hoisted to the top',
    body: 'When a reply opens with a TL;DR line, it is lifted into a band above everything else. It is never synthesized from the first sentence; if the reply has no summary, the band is absent. A UserPromptSubmit hook reminds the model to supply one while mode is on.',
    live: `${examples}/explainer.html`
  },
  {
    id: 'map',
    n: '02',
    name: 'Concept map',
    tag: 'mermaid → interactive SVG · click a node to find its section',
    body: 'A mermaid graph in the reply becomes a pure-SVG map. Hover a node to trace its edges; click to scroll to the matching section and open a detail panel; drag to pan; scroll or +/-/0 to zoom. No mermaid runtime; the map ships inside the artifact. No graph in the reply? A table-of-contents rail takes its place instead of a fabricated one.',
    live: `${examples}/diagram.html`
  },
  {
    id: 'reading',
    n: '03',
    name: 'Reading body',
    tag: '18px · 66ch · system sans · high contrast',
    body: 'Body type set for screen reading: 18px, 66ch measure, system sans. No drop cap, no roman-numeral sections, no all-small-caps. A reading-order stepper walks the sections (j / k), in-page search filters them (/), and a settings gear controls theme, size, width, and font.',
    live: `${examples}/prose.html`
  }
];

const decisions = [
  {
    id: 'plan',
    n: '04',
    name: 'plan',
    tag: 'phase sidebar · live status · focus checkboxes',
    body: 'Phase sidebar with progress, status per task (◯ pending · ◐ in-progress · ● done · ✕ failed), and a meta-refresh that re-renders as Claude reports progress. Tick the tasks to focus next; Copy as prompt emits only those.',
    live: `${examples}/plan.html`
  },
  {
    id: 'comparison',
    n: '05',
    name: 'comparison',
    tag: 'side-by-side · pros / cons · pick + reason',
    body: 'Side-by-side cards with pros and cons pulled into colored panels and a recommended badge when Claude marks one. Pick a card, add a one-line reason; Copy as prompt emits the choice and the reason, never the whole comparison.',
    live: `${examples}/comparison.html`
  }
];
---
<Base title="to-html" description="HTML rendering for Claude Code: TL;DR, an interactive concept map, and reading-first typography. Quiet by default.">

  <section class="hero">
    <p class="kicker">to-html</p>
    <h1 class="head">Render Claude Code<br>output as&nbsp;HTML.</h1>
    <p class="dek">
      Type <code>/to-html</code> once. Substantive replies render into one self-contained page with a TL;DR band, an
      interactive concept map, and a body set for reading. Quiet by default: short or flat replies render nothing, and
      nothing opens a browser tab unless you turn auto-open on.
    </p>

    <div class="install">
      <div class="install-row">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">/plugin marketplace add ibrahemid/plugins</span>
        <button type="button" class="copy" data-clip="/plugin marketplace add ibrahemid/plugins" aria-label="Copy marketplace command">copy</button>
      </div>
      <div class="install-row">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">/plugin install to-html@ibrahemid</span>
        <button type="button" class="copy" data-clip="/plugin install to-html@ibrahemid" aria-label="Copy install command">copy</button>
      </div>
    </div>
  </section>

  <a class="hero-shot" href={`${examples}/diagram.html`} target="_blank" rel="noopener" aria-label="Open a live concept-map artifact">
    <img src={`${shots}/understanding-map-light.png`} alt="to-html artifact: TL;DR band, concept map, reading body" loading="eager" width="2560" height="1760">
    <span class="hero-shot-overlay">open live →</span>
  </a>

  <div class="section-label"><span>01 / anatomy</span></div>

  <section class="specimens">
    {parts.map((t) => (
      <article id={t.id} class="spec">
        <header class="spec-head">
          <span class="spec-n">{t.n}</span>
          <div>
            <p class="spec-tag">{t.tag}</p>
            <h2 class="spec-name">{t.name}</h2>
          </div>
        </header>
        <div class="spec-grid">
          <div class="spec-meta">
            <p class="spec-actions"><a href={t.live} target="_blank" rel="noopener">open live artifact →</a></p>
          </div>
          <div class="spec-body"><p>{t.body}</p></div>
        </div>
      </article>
    ))}
  </section>

  <div class="section-label"><span>02 / decision tools</span></div>

  <section class="specimens">
    {decisions.map((t) => (
      <article id={t.id} class="spec">
        <header class="spec-head">
          <span class="spec-n">{t.n}</span>
          <div>
            <p class="spec-tag">{t.tag}</p>
            <h2 class="spec-name">{t.name}</h2>
          </div>
        </header>
        <div class="spec-grid">
          <div class="spec-meta">
            <p class="spec-actions"><a href={t.live} target="_blank" rel="noopener">open live artifact →</a></p>
          </div>
          <div class="spec-body"><p>{t.body}</p></div>
        </div>
      </article>
    ))}
  </section>

  <div class="section-label"><span>03 / quiet by default</span></div>

  <section class="appendix">
    <p>
      Toggling on does not open a browser tab. The artifact is written and a <code>file://</code> link is printed; you
      open it when you want it. A reply renders only when it carries structure: 600+ chars, or 2+ headings, a code block,
      a table, checkboxes, or a graph. A manual <code>/to-html</code> toggle always renders the reply you were looking at.
    </p>
    <p>Set durable defaults per project:</p>
<pre>{`/to-html config auto-open  yes | no
/to-html config theme      auto | light | dark | sepia
/to-html config size       s | m | l | xl
/to-html config width      narrow | comfortable | wide
/to-html config font       sans | serif`}</pre>
    <p>
      Force a template from any reply by prepending a fenced block. Unknown templates fall back to the classifier; skip is rejected.
    </p>
<pre>{`\`\`\`to-html
{"template":"diagram","title":"Auth handshake"}
\`\`\``}</pre>
  </section>

  <script>
    document.querySelectorAll('.copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-clip');
        if (!text) return;
        const restore = btn.textContent;
        const done = () => {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = restore; }, 1200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, () => fallback(text, done));
        } else fallback(text, done);
      });
    });
    function fallback(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.position = 'absolute'; ta.style.left = '-9999px';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
      done();
    }
  </script>
</Base>

<style>
  .hero { margin: 0 0 40px; }
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 12px;
  }
  .head {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .dek {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 28px;
  }
  .dek code { font-size: 0.92em; }

  .install { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .install-row {
    display: inline-flex;
    align-items: center;
    background: var(--terminal-bg);
    color: var(--terminal-fg);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 4px 4px 4px 14px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1;
  }
  .install-row .prompt { color: var(--terminal-prompt); font-weight: 600; margin-right: 10px; }
  .install-row .cmd { padding: 8px 14px 8px 0; }
  .install-row .copy {
    background: var(--terminal-fg);
    color: var(--terminal-bg);
    border: 0;
    padding: 8px 14px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-weight: 600;
  }
  .install-row .copy:hover { opacity: 0.85; }

  .hero-shot {
    display: block;
    margin: 0 0 8px;
    border: 1px solid var(--rule);
    background: var(--paper-tint);
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    transition: border-color 200ms ease;
  }
  .hero-shot:hover { border-color: var(--accent); }
  .hero-shot img { display: block; width: 100%; height: auto; }
  .hero-shot-overlay {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    border-radius: 3px;
    transform: translateY(4px);
    opacity: 0;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .hero-shot:hover .hero-shot-overlay { transform: translateY(0); opacity: 1; }

  .specimens { display: flex; flex-direction: column; gap: 56px; }
  .spec { margin: 0; }
  .spec-head {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: end;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .spec-n {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .spec-tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 4px;
  }
  .spec-name {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1;
    margin: 0;
    color: var(--ink);
  }
  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 56px;
    align-items: start;
    padding-left: 92px;
  }
  .spec-actions { margin: 0; font-family: var(--mono); font-size: 0.78rem; }
  .spec-actions a { color: var(--accent); border-bottom-color: var(--accent-line); }
  .spec-body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 56ch;
  }

  .appendix { max-width: 720px; }
  .appendix p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 14px;
    max-width: 56ch;
  }
  .appendix pre { display: block; margin: 16px 0; max-width: 100%; }

  @media (max-width: 960px) {
    .spec-grid { grid-template-columns: 1fr; gap: 20px; padding-left: 0; }
    .spec-head { grid-template-columns: 48px 1fr; gap: 14px; }
    .spec-n { font-size: 1.875rem; }
  }
</style>
