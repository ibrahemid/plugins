---
import Base from '../../layouts/Base.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const shots = `${baseUrl}/screenshots`;
const examples = `${baseUrl}/examples/to-html`;

const templates = [
  {
    id: 'prose',
    n: '01',
    name: 'prose',
    tag: 'editorial typography',
    trigger: 'Default for anything substantive with no special structure.',
    body: 'Narrow column. Big drop into the first paragraph. No chrome. The point is to actually read the thing — paragraphs, code, tables — without a "we made this safe!" footer eating space.',
    thumb: `${shots}/thumb-prose.png`,
    full: `${shots}/tpl-prose.png`,
    live: `${examples}/prose.html`,
    decision: 'No copy button. Read-only.'
  },
  {
    id: 'plan',
    n: '02',
    name: 'plan',
    tag: 'phase sidebar · live status · focus checkboxes',
    trigger: '## Phase N: headings or three-plus [ ] tasks.',
    body: 'Phase sidebar with progress bars, status badges per task (◯ pending · ◐ in-progress · ● done · ✕ failed), and a meta-refresh that re-renders every three seconds. As Claude reports task progress in plain English, the Stop hook diffs the reply and flips statuses live.',
    thumb: `${shots}/thumb-plan.png`,
    full: `${shots}/tpl-plan.png`,
    live: `${examples}/plan.html`,
    decision: 'Tick the tasks you want focused next. Copy as prompt emits only those — never the whole plan.'
  },
  {
    id: 'comparison',
    n: '03',
    name: 'comparison',
    tag: 'side-by-side · pros / cons · pick + reason',
    trigger: 'Two or three ## Option / Approach / Variant headings.',
    body: 'Real side-by-side cards. Pros and cons are detected and pulled into their own colored panels. An effort meter and a "Recommended" badge appear when Claude marks them.',
    thumb: `${shots}/thumb-comparison.png`,
    full: `${shots}/tpl-comparison.png`,
    live: `${examples}/comparison.html`,
    decision: 'Click a card to pick. Type a one-line reason. Copy as prompt emits the choice and the reason.'
  },
  {
    id: 'explainer',
    n: '04',
    name: 'explainer',
    tag: 'TL;DR pill · sticky TOC',
    trigger: 'TL;DR keyword or multi-section structure without heavy bulleting.',
    body: 'For "explain X" replies. TL;DR pill at the top, a sticky table of contents on the side, the body sized for actual reading. No decision bar — this template is for understanding, not deciding.',
    thumb: `${shots}/thumb-explainer.png`,
    full: `${shots}/tpl-explainer.png`,
    live: `${examples}/explainer.html`,
    decision: 'No copy button. Read-only.'
  }
];
---
<Base title="to-html — specimen" description="Specimen sheet for the to-html plugin templates.">

  <section class="hero">
    <p class="kicker">to-html · specimen sheet</p>
    <h1 class="head">Five templates.<br>One toggle.</h1>
    <p class="dek">
      Type <code>/to-html</code> once. Every substantive reply is classified server-side
      and rendered into the template that fits the content. Below: every template,
      with a real example. Click the thumbnail to interact with the actual artifact —
      these are the same HTML files the plugin produces on disk.
    </p>
    <div class="install-row">
      <span class="install-label">Install</span>
<pre>/plugin marketplace add ibrahemid/plugins
/plugin install to-html@ibrahemid</pre>
    </div>
  </section>

  <hr class="rule">

  <nav class="specimen-toc" aria-label="Templates">
    <p class="toc-kicker">Templates</p>
    <ol>
      {templates.map((t) => (
        <li>
          <a href={`#${t.id}`}>
            <span class="toc-n">{t.n}</span>
            <span class="toc-name">{t.name}</span>
            <span class="toc-tag">{t.tag}</span>
          </a>
        </li>
      ))}
      <li class="toc-skip">
        <span class="toc-n">05</span>
        <span class="toc-name">skip</span>
        <span class="toc-tag">under 240 chars, no structure — no artifact at all</span>
      </li>
    </ol>
  </nav>

  <hr class="rule">

  {templates.map((t, idx) => (
    <article id={t.id} class="spec">
      <header class="spec-head">
        <span class="spec-n">{t.n}</span>
        <div>
          <p class="spec-tag">{t.tag}</p>
          <h2 class="spec-name">{t.name}</h2>
        </div>
      </header>

      <div class="spec-grid">
        <div class="spec-meta">
          <dl>
            <dt>Triggers on</dt>
            <dd>{t.trigger}</dd>
            <dt>Two-way</dt>
            <dd>{t.decision}</dd>
          </dl>
          <p class="spec-actions">
            <a href={t.live} target="_blank" rel="noopener">Interact with the live artifact →</a>
          </p>
        </div>
        <div class="spec-body">
          <p>{t.body}</p>
        </div>
      </div>

      <a class="spec-shot" href={t.live} target="_blank" rel="noopener" aria-label={`Open ${t.name} live`}>
        <img src={t.thumb} alt={`${t.name} preview`} loading="lazy">
        <span class="spec-shot-overlay">Open live →</span>
      </a>

      {idx < templates.length - 1 && <hr class="rule">}
    </article>
  ))}

  <hr class="rule">

  <section class="appendix">
    <p class="appendix-kicker">Appendix · override</p>
    <p class="appendix-body">
      If the classifier picks wrong, force a template by prepending a fenced block to a reply:
    </p>
<pre>{`\`\`\`to-html
{"template":"comparison","title":"Three approaches"}
\`\`\``}</pre>
    <p class="appendix-body">
      Unknown templates fall back to the classifier. Skip is rejected — that's a refusal disguised as an override.
    </p>
  </section>
</Base>

<style>
  .hero { margin: 8px 0 56px; }
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 16px;
  }
  .head {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
  }
  .dek {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 32px;
    font-style: italic;
  }
  .install-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .install-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 16px;
  }
  .rule { border-top-color: var(--ink); opacity: 0.6; margin: 64px 0; }

  .specimen-toc { margin: 0; }
  .toc-kicker {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 18px;
  }
  .specimen-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .specimen-toc li {
    border-top: 1px solid var(--rule);
  }
  .specimen-toc li:last-child { border-bottom: 1px solid var(--rule); }
  .specimen-toc a, .specimen-toc .toc-skip {
    display: grid;
    grid-template-columns: 72px 220px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: none;
    color: var(--ink);
  }
  .specimen-toc a:hover { color: var(--accent); }
  .toc-n {
    font-family: var(--mono);
    color: var(--ink-faint);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .toc-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }
  .toc-tag {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .toc-skip { color: var(--ink-faint); }
  .toc-skip .toc-name { color: var(--ink-faint); font-style: italic; }

  .spec { margin: 0; }
  .spec-head {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: 32px;
  }
  .spec-n {
    font-family: var(--mono);
    font-size: 3.25rem;
    font-weight: 500;
    color: var(--accent);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .spec-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 6px;
  }
  .spec-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 56px;
    align-items: start;
    padding-left: 112px;
  }
  .spec-meta dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .spec-meta dt {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.66rem;
    margin: 0;
  }
  .spec-meta dd {
    margin: 0;
    color: var(--ink-muted);
  }
  .spec-actions {
    margin: 24px 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .spec-actions a { color: var(--accent); border-bottom-color: var(--accent-line); }
  .spec-body p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .spec-body p::first-letter {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 3.2rem;
    float: left;
    line-height: 0.86;
    padding: 8px 12px 0 0;
    color: var(--accent);
  }

  .spec-shot {
    display: block;
    margin: 40px 0 0 112px;
    border: 1px solid var(--rule);
    background: var(--paper-tint);
    position: relative;
    overflow: hidden;
    border-bottom: none;
    transition: border-color 200ms ease;
  }
  .spec-shot:hover { border-color: var(--accent); }
  .spec-shot img { display: block; width: 100%; height: auto; }
  .spec-shot-overlay {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 14px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(8px);
    opacity: 0;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .spec-shot:hover .spec-shot-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .appendix { max-width: 720px; }
  .appendix-kicker {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 18px;
  }
  .appendix-body {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .appendix pre { display: block; margin: 0 0 16px; }

  @media (max-width: 960px) {
    .spec-grid { grid-template-columns: 1fr; gap: 24px; padding-left: 0; }
    .spec-shot { margin-left: 0; }
    .spec-head { grid-template-columns: 56px 1fr; gap: 16px; }
    .spec-n { font-size: 2.2rem; }
    .specimen-toc a, .specimen-toc .toc-skip {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
    }
    .toc-tag { grid-column: 2; }
  }
</style>
