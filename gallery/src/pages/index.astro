---
import Base from '../layouts/Base.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const plugins = [
  {
    n: '01',
    name: 'to-html',
    href: `${baseUrl}/to-html`,
    tag: 'HTML rendering mode',
    pitch: 'Type /to-html. Every substantive reply is classified and rendered into a self-contained HTML file that opens in the browser. Plans become live dashboards. Comparisons become pickers. Trivial replies get nothing — your terminal stays clean.',
    install: '/plugin install to-html@ibrahemid',
    facts: [
      ['Surface', 'Skill + Stop hook + PostToolUse hook'],
      ['Templates', '5 — prose, plan, comparison, explainer, skip'],
      ['Renderer', 'Deterministic Node 18+. Zero npm install.'],
      ['Cost', 'Markdown tokens. Claude never writes HTML.']
    ],
    cover: `${baseUrl}/screenshots/thumb-plan.png`
  },
  {
    n: '02',
    name: 'sesh',
    href: 'https://github.com/ibrahemid/plugins/tree/main/plugins/sesh',
    tag: 'Auto-name sessions',
    pitch: 'A silent UserPromptSubmit hook that watches the first few user messages and names the session from conversation context. No prompting, no UI.',
    install: '/plugin install sesh@ibrahemid',
    facts: [
      ['Surface', 'UserPromptSubmit hook'],
      ['Fires once', 'after ~3 user messages'],
      ['Renderer', 'TypeScript, compiled to plain Node'],
      ['Cost', 'One short prompt per session']
    ],
    cover: null
  }
];
---
<Base title="plugins — gallery" description="Claude Code plugins. Live, interactive examples.">

  <section class="hero">
    <p class="kicker">Issue No. 01 — Spring 2026</p>
    <h1 class="head">Read what the<br>agent wrote.</h1>
    <p class="dek">
      Two plugins for Claude Code. One installs in a line and renders every substantive reply
      as the right kind of document. The other names your session so you can find it again.
      Below: install, then the long form on each.
    </p>
    <div class="install-row">
      <span class="install-label">Install</span>
      <pre>/plugin marketplace add ibrahemid/plugins</pre>
    </div>
  </section>

  <hr class="rule">

  {plugins.map((p, idx) => (
    <article class="entry">
      <header class="entry-head">
        <span class="entry-n">{p.n}</span>
        <div>
          <p class="entry-tag">{p.tag}</p>
          <h2 class="entry-name"><a href={p.href}>{p.name}</a></h2>
        </div>
      </header>

      <div class="entry-grid">
        <div class="entry-body">
          <p class="entry-pitch">{p.pitch}</p>
          <pre class="entry-install">{p.install}</pre>
          {p.href.startsWith(baseUrl) && (
            <p class="entry-cta"><a href={p.href}>Read the long form →</a></p>
          )}
        </div>
        <aside class="entry-facts">
          <dl>
            {p.facts.map(([k, v]) => (
              <Fragment>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </Fragment>
            ))}
          </dl>
        </aside>
      </div>

      {p.cover && (
        <a class="entry-cover" href={p.href} aria-label={`Open ${p.name}`}>
          <img src={p.cover} alt={`${p.name} preview`} loading="lazy">
        </a>
      )}

      {idx < plugins.length - 1 && <hr class="rule">}
    </article>
  ))}

  <hr class="rule">

  <section class="manifesto">
    <p class="manifesto-kicker">Editor's note</p>
    <p class="manifesto-body">
      Thariq Shihipar wrote a piece called <em>The Unreasonable Effectiveness of HTML</em>. The argument: markdown
      linearizes everything an agent wants to express. Tables get flattened. Comparisons become bullet lists. Mockups
      become ASCII. The agent's medium is supposed to be expressive — and the format we settled on isn't.
    </p>
    <p class="manifesto-body">
      <code>to-html</code> takes that argument seriously without forcing it on every reply. The Stop hook quietly decides
      which template fits each turn. Plans get a phase sidebar with live status. Comparisons get pickers. Explainers get
      a TOC. Trivial replies are left alone — the goal is fewer artifacts, not more.
    </p>
    <p class="manifesto-body">
      Nothing leaves your machine. The renderer is deterministic Node. Claude never writes HTML, so token cost stays at
      markdown cost. Every artifact ships with a strict CSP — no network, no remote assets, no forms.
    </p>
  </section>
</Base>

<style>
  .hero {
    margin: 8px 0 64px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 16px;
  }
  .head {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .dek {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 36px;
    font-style: italic;
  }
  .install-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .install-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .install-row pre {
    display: inline-block;
    margin: 0;
  }
  .rule {
    border-top-color: var(--ink);
    opacity: 0.6;
    margin: 72px 0;
  }
  .entry { margin: 0; }
  .entry-head {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: 36px;
  }
  .entry-n {
    font-family: var(--mono);
    font-size: 3.5rem;
    font-weight: 500;
    color: var(--accent);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .entry-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 8px;
  }
  .entry-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .entry-name a {
    border-bottom: none;
    color: var(--ink);
  }
  .entry-name a:hover { color: var(--accent); }

  .entry-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
    padding-left: 112px;
  }
  .entry-pitch {
    font-size: 1.125rem;
    line-height: 1.55;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .entry-install {
    display: inline-block;
    margin: 0 0 18px;
  }
  .entry-cta {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
  .entry-cta a { color: var(--accent); border-bottom-color: var(--accent-line); }

  .entry-facts dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 24px;
    row-gap: 12px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
    border-top: 1px solid var(--rule);
    padding-top: 16px;
  }
  .entry-facts dt {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
    padding-top: 2px;
  }
  .entry-facts dd { margin: 0; color: var(--ink-muted); }

  .entry-cover {
    display: block;
    margin: 48px 0 0 112px;
    border-bottom: none;
    border: 1px solid var(--rule);
    background: var(--paper-tint);
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .entry-cover:hover {
    border-color: var(--accent);
  }
  .entry-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .manifesto {
    max-width: 680px;
    margin: 0 auto;
  }
  .manifesto-kicker {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
    margin: 0 0 20px;
  }
  .manifesto-body {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink);
    margin: 0 0 18px;
    text-align: justify;
    hyphens: auto;
  }
  .manifesto-body em { font-style: italic; color: var(--accent-deep); }

  @media (max-width: 960px) {
    .entry-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-left: 0;
    }
    .entry-cover {
      margin-left: 0;
    }
    .entry-head {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }
    .entry-n { font-size: 2.4rem; }
  }
  @media (max-width: 720px) {
    .head { font-size: 2.4rem; }
    .dek { font-size: 1.05rem; }
    .entry-pitch { font-size: 1rem; }
  }
</style>
