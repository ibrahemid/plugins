---
import Base from '../layouts/Base.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const plugins = [
  {
    n: '01',
    name: 'to-html',
    href: `${baseUrl}/to-html`,
    tag: 'understanding view',
    pitch: 'Toggle on. Substantive replies render to a self-contained page with a TL;DR band, an interactive concept map from mermaid blocks, and a body set for reading. Plans get a phase sidebar; comparisons get pickers. Quiet by default: short or flat replies render nothing.',
    install: '/plugin install to-html@ibrahemid',
    facts: [
      ['surface', 'skill + Stop + UserPromptSubmit + PostToolUse hooks'],
      ['artifact', 'TL;DR · concept map · stepper · search · settings'],
      ['runtime', 'Node 18+. No npm install. Vendored marked.'],
      ['tests', '102 cases via node --test']
    ],
    cover: `${baseUrl}/screenshots/understanding-map-light.png`
  },
  {
    n: '02',
    name: 'sesh',
    href: 'https://github.com/ibrahemid/plugins/tree/main/plugins/sesh',
    tag: 'Auto-name sessions',
    pitch: 'A silent UserPromptSubmit hook that watches the first few user messages and names the session from conversation context. No prompting, no UI.',
    install: '/plugin install sesh@ibrahemid',
    facts: [
      ['surface', 'UserPromptSubmit hook'],
      ['fires', 'once, after ~3 user messages'],
      ['runtime', 'TypeScript, compiled to plain Node']
    ],
    cover: null
  }
];
---
<Base title="ibrahemid/plugins" description="Claude Code plugins. Render agent replies as HTML artifacts.">

  <section class="hero">
    <h1 class="head">Render agent output<br>as&nbsp;HTML.</h1>
    <p class="dek">
      A Claude Code plugin workspace. Substantive replies are classified server-side and rendered into a self-contained page
      with a TL;DR, an interactive concept map, and reading-first type. Deterministic Node, no npm install. Two plugins, MIT.
    </p>

    <div class="install">
      <div class="install-row">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">/plugin marketplace add ibrahemid/plugins</span>
        <button type="button" class="copy" data-clip="/plugin marketplace add ibrahemid/plugins" aria-label="Copy install command">copy</button>
      </div>
    </div>
  </section>

  <div class="section-label"><span>01 / plugins</span></div>

  <section class="entries">
    {plugins.map((p) => (
      <article class="entry">
        <header class="entry-head">
          <span class="entry-n">{p.n}</span>
          <div class="entry-title">
            <p class="entry-tag">{p.tag}</p>
            <h2 class="entry-name"><a href={p.href}>{p.name}</a></h2>
          </div>
        </header>

        <div class="entry-grid">
          <div class="entry-body">
            <p class="entry-pitch">{p.pitch}</p>
            <div class="entry-install">
              <code>{p.install}</code>
              <button type="button" class="copy small" data-clip={p.install} aria-label={`Copy install command for ${p.name}`}>copy</button>
            </div>
            {p.href.startsWith(baseUrl) && (
              <p class="entry-cta"><a href={p.href}>details →</a></p>
            )}
          </div>
          <aside class="entry-facts" aria-label={`${p.name} facts`}>
            <dl>
              {p.facts.map(([k, v]) => (
                <Fragment>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </Fragment>
              ))}
            </dl>
          </aside>
        </div>

        {p.cover && (
          <a class="entry-cover" href={p.href} aria-label={`Open ${p.name}`}>
            <img src={p.cover} alt={`${p.name} preview`} loading="lazy" width="2880" height="1800">
          </a>
        )}
      </article>
    ))}
  </section>

  <div class="section-label"><span>02 / how it works</span></div>

  <section class="rationale">
    <p>
      Markdown in a terminal flattens structure: tables linearize, comparisons become bullet lists. Each artifact leads with
      the reply's TL;DR, turns a mermaid block into a concept map you can click through to the matching section, and sets the
      body for reading. Plans get a phase sidebar with live status; comparisons get pickers. Replies without structure render
      nothing.
    </p>
    <p>
      The renderer is deterministic Node. Claude never writes HTML, so token cost stays at markdown cost. Every artifact ships
      with a strict CSP: no network, no remote assets, no forms.
    </p>
  </section>

  <script>
    document.querySelectorAll('.copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-clip');
        if (!text) return;
        const restore = btn.textContent;
        const done = () => {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = restore; }, 1200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, () => fallback(text, done));
        } else fallback(text, done);
      });
    });
    function fallback(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.position = 'absolute'; ta.style.left = '-9999px';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
      done();
    }
  </script>
</Base>

<style>
  .hero {
    margin: 0 0 64px;
  }
  .head {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .dek {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 32px;
  }

  .install {
    display: inline-block;
  }
  .install-row {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--terminal-bg);
    color: var(--terminal-fg);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 4px 4px 4px 14px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1;
  }
  .install-row .prompt {
    color: var(--terminal-prompt);
    font-weight: 600;
    margin-right: 10px;
  }
  .install-row .cmd {
    padding: 8px 14px 8px 0;
  }
  .install-row .copy {
    background: var(--terminal-fg);
    color: var(--terminal-bg);
    border: 0;
    padding: 8px 14px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-weight: 600;
    transition: opacity 120ms ease;
  }
  .install-row .copy:hover { opacity: 0.85; }
  .install-row .copy:active { transform: translateY(1px); }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .entry { margin: 0; }
  .entry-head {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: end;
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .entry-n {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 3rem;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .entry-tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 6px;
  }
  .entry-name {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--ink);
  }
  .entry-name a {
    border-bottom: none;
    color: var(--ink);
  }
  .entry-name a:hover { color: var(--accent); }

  .entry-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: start;
    padding-left: 92px;
  }

  .entry-pitch {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 20px;
    color: var(--ink);
    max-width: 56ch;
  }

  .entry-install {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 4px;
  }
  .entry-install code {
    background: transparent;
    border: none;
    font-size: 0.78rem;
    padding: 6px 10px;
    color: var(--ink);
  }
  .entry-install .copy {
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 6px 10px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-weight: 600;
  }

  .entry-cta {
    margin: 8px 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .entry-cta a {
    color: var(--accent);
    border-bottom-color: var(--accent-line);
  }

  .entry-facts dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 18px;
    row-gap: 10px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
    border-top: 1px solid var(--rule);
    padding-top: 14px;
  }
  .entry-facts dt {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.66rem;
    padding-top: 2px;
  }
  .entry-facts dd { margin: 0; color: var(--ink-muted); }

  .entry-cover {
    display: block;
    margin: 36px 0 0 92px;
    border: 1px solid var(--rule);
    background: var(--paper-tint);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    transition: border-color 200ms ease;
    border-radius: 4px;
  }
  .entry-cover:hover {
    border-color: var(--accent);
  }
  .entry-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .rationale {
    max-width: 660px;
  }
  .rationale p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .rationale em { font-style: italic; color: var(--ink); }
  .rationale code { font-size: 0.84em; }

  @media (max-width: 960px) {
    .entry-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-left: 0;
    }
    .entry-cover { margin-left: 0; }
    .entry-head { grid-template-columns: 48px 1fr; gap: 14px; }
    .entry-n { font-size: 2rem; }
  }
  @media (max-width: 720px) {
    .head { font-size: 2.2rem; }
    .install-row { flex-wrap: wrap; }
  }
</style>
